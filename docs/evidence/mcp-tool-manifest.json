      "inputSchema": {
        "type": "object",
        "properties": {
          "drawingId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer"
          },
          "elementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "drawingId",
          "expectedRevision",
          "elementIds"
        ]
      }
    },
    {
      "name": "set_path",
      "description": "Replace world-coordinate points on an existing sketch Line, Arrow or Freehand, preserving its identity/style and supporting undo. All native path/bounds limits apply.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "drawingId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer"
          },
          "elementId": {
            "type": "string",
            "format": "uuid"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          }
        },
        "required": [
          "drawingId",
          "expectedRevision",
          "elementId",
          "points"
        ]
      }
    },
    {
      "name": "set_viewport",
      "description": "Set viewport size, world pan and zoom, or fit=true to fit the drawing. Viewport-only changes do not modify native geometry or undo history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "drawingId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer"
          },
          "width": {
            "type": "number",
            "default": 800
          },
          "height": {
            "type": "number",
            "default": 600
          },
          "zoom": {
            "type": "number",
            "default": 1
          },
          "panX": {
            "type": "number",
            "default": 0
          },
          "panY": {
            "type": "number",
            "default": 0
          },
          "fit": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "drawingId",
          "expectedRevision"
        ]
      }
    },
    {
