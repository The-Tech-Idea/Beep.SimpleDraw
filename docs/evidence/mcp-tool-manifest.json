          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": [
              "number",
              "null"
            ],
            "default": null
          },
          "height": {
            "type": [
              "number",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "drawingId",
          "expectedRevision",
          "type",
          "x",
          "y"
        ]
      }
    },
    {
      "name": "list_drawings",
