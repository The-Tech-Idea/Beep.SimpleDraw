{
  "tools": [
    {
      "name": "insert_library_entry",
      "description": "Insert a reusable library entry at world coordinates, generating fresh object/group/port IDs and preserving internal connectors.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "drawingId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer"
          },
          "entryId": {
            "type": "string",
            "format": "uuid"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "drawingId",
          "expectedRevision",
          "entryId",
          "x",
          "y"
        ]
      }
    },
    {
      "name": "export_drawing",
      "description": "Export native SimpleDraw JSON, PNG, SVG or personal-library JSON to a generated file under this workspace/artifacts. Returns absolute path and native JSON for native/library export. Open native files in SimpleDraw. Image exports use all actual Beep.Skia renderers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "drawingId": {
            "type": "string",
            "format": "uuid"
          },
          "format": {
            "type": "string",
            "default": "native"
          },
          "scale": {
            "type": "number",
            "default": 1
          },
          "background": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "drawingId"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "create_drawing",
      "description": "Create a named empty drawing. Returns ID and revision. All mutations require the current expectedRevision returned by a previous call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "get_ports",
      "description": "Read actual input/output ports on a drawing element: stable IDs, index, datatype, availability and world coordinates. Default topology is also in describe_component.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "drawingId": {
            "type": "string",
            "format": "uuid"
          },
          "elementId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "drawingId",
          "elementId"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "undo",
      "description": "Undo the latest drawing edit in this server process. History resets when another process changes this drawing or the server restarts; native files persist.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "drawingId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer"
          }
        },
        "required": [
          "drawingId",
          "expectedRevision"
        ]
      }
    },
    {
      "name": "duplicate_elements",
