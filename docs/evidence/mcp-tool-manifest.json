              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ]
            },
            "default": null
          }
        },
        "required": [
          "drawingId",
          "expectedRevision",
          "kind"
        ]
      }
    },
    {
      "name": "connect_nodes",
