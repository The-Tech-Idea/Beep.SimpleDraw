    {
      "name": "add_sketch",
      "description": "Create Rectangle, Ellipse, Diamond, Line, Arrow, Freehand or Text. Bounds and path points use world coordinates. Line/Arrow/Freehand require 2-4096 points. Text uses bundled font measurements. Colors accept #RRGGBB or #AARRGGBB.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "drawingId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer"
          },
          "kind": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "default": 0
          },
          "y": {
            "type": "number",
            "default": 0
          },
          "width": {
            "type": "number",
            "default": 120
          },
          "height": {
            "type": "number",
            "default": 80
          },
          "text": {
            "type": "string",
            "default": ""
          },
          "stroke": {
            "type": "string",
            "default": "#334155"
          },
          "fill": {
            "type": "string",
            "default": "#00000000"
          },
          "strokeWidth": {
            "type": "number",
            "default": 2
          },
          "fontSize": {
            "type": "number",
            "default": 24
          },
          "roughness": {
            "type": "number",
            "default": 0
          },
          "points": {
            "type": [
              "array",
              "null"
