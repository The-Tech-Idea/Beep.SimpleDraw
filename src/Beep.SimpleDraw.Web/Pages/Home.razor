    [JSInvokable] public async Task Shortcut(string key, bool control, bool shift)
    {
        if (ModalActive) return;
        if (control)
        {
            if (key == "z") { if (shift) Redo(); else Undo(); }
            else if (key == "y") Redo();
            else if (key == "s") await Save();
            else if (key == "d") Command(_session.DuplicateSelection);
            else if (key == "g") Command(() => _session.GroupSelection(shift));
            else if (key == "a") { _session.Tool = DrawingTool.Select; _session.Manager.SelectAllComponents(); _canvas?.Invalidate(); }
        }
        else
        {
            var tool = Tools.FirstOrDefault(t => t.Key.Equals(key, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(tool.Key)) { Choose(tool.Tool); if (_module is not null) await _module.InvokeVoidAsync("focusCanvas"); }
            else if (key is "Delete" or "Backspace") Delete();
            else if (key == "Escape") { _session.CancelGesture(); _showHelp = false; _canvas?.Invalidate(); }
            else if (key == "?") _showHelp = true;
            else if (key == "Enter") { Command(_session.KeyboardEnter); if (_session.HasTextEdit) StartTextEditor(); _canvas?.Invalidate(); }
            else if (key.StartsWith("Arrow"))
            {
                var d = _session.Tool != DrawingTool.Select ? (shift ? 20 : 5) : (shift ? 10 : 1);
                var delta = key switch { "ArrowLeft" => new SKPoint(-d, 0), "ArrowRight" => new( d, 0), "ArrowUp" => new(0, -d), _ => new(0, d) };
                if (_session.Tool == DrawingTool.Select) _session.MoveSelected(delta);
                else if (_session.Tool == DrawingTool.Hand) _session.Manager.PanOffset += delta;
                else _session.MoveKeyboardCursor(delta);
                _canvas?.Invalidate();
            }
        }
        AnnounceSelection();
        await InvokeAsync(StateHasChanged);
    }
