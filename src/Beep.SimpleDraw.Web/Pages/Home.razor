    private void Pointer(CanvasPointerEvent args)
    {
        if (args.Action == "resize") { _session.ResizeViewport(args.Width, args.Height); _canvas?.Invalidate(); return; }
        if (_storagePanel || _confirmReplace || _showHelp || _session.HasTextEdit) return;
        switch (args.Action)
        {
            case "down": Command(() => _session.PointerDown(args.Position, args.Button == 1, args.Shift)); if (_session.HasTextEdit) StartTextEditor(); break;
            case "move":
                foreach (var sample in args.Samples) _session.PointerMove(sample.Position);
                _session.PointerMove(args.Position); break;
            case "up": _session.PointerUp(args.Position); break;
            case "cancel": _session.CancelGesture(); break;
            case "wheel": _session.ScrollViewport(args.Position, args.DeltaX, args.Delta, args.Control, args.Shift); break;
            case "doubleclick": Command(() => _session.BeginText(args.Position, false)); if (_session.HasTextEdit) StartTextEditor(); break;
            case "pinchstart": _session.BeginViewportGesture(args.Position); break;
            case "pinchmove": _session.UpdateViewportGesture(args.Position,args.Scale); break;
            case "pinchend": _session.EndViewportGesture(); break;
        }
        if (_session.GestureNotice is not null) { _message = _session.GestureNotice; _error = true; }
        AnnounceSelection();
    }
